# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas (production):
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<AppName>

# MongoDB local (dev):
# DATABASE_URL=mongodb://localhost:27017

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_DB_NAME=users_db
MONGODB_COLLECTION=users

# ─── JWT (must be identical across all services) ─────────────────────────────
JWT_SECRET=change-me-in-production

# ─── Encryption (must be identical across all services) ──────────────────────
MASTER_KEY=change-me-in-production
