# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas (production):
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<AppName>

# MongoDB local (dev):
# DATABASE_URL=mongodb://localhost:27017

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_DB_NAME=users_db
MONGODB_COLLECTION=users

# ─── JWT (must be identical across all services) ─────────────────────────────
JWT_SECRET=change-me-in-production

# ─── Encryption (must be identical across all services) ──────────────────────
MASTER_KEY=change-me-in-production

# ─── CORS (comma-separated list of allowed origins) ──────────────────────────
ALLOWED_ORIGINS=https://lovelaundry-manager.vercel.app,https://lovelaundry-shop-app.vercel.app,http://localhost:5173,http://localhost:3000,https://system-lovelaundry-lk.vercel.app,https://hotels-manager-amber.vercel.app,https://hotels-manager.vercel.app,https://shops-manager.vercel.app,http://localhost,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://127.0.0.1:5173,http://localhost:8101,http://127.0.0.1:8101,http://localhost:8820,http://127.0.0.1:8820

# ─── Error tracking (optional) ───────────────────────────────────────────────
# SENTRY_DSN=

# ─── Timezone ───────────────────────────────────────────────────────────────
# All business days, reports and "today" run on Sri Lanka time. The code pins
# this itself (see app_time.py), so this only matters for anything that falls
# back to the host clock — logs, third-party libs, `date` in a shell.
TZ=Asia/Colombo
