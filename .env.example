# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB (recommended):
DATABASE_URL=mongodb://localhost:27017

# PostgreSQL alternative:
# DATABASE_URL=postgresql://user:password@localhost:5432/user_db

# SQLite alternative (dev only):
# DATABASE_URL=sqlite:///./user_db.sqlite

# ─── MongoDB specific ────────────────────────────────────────────────────────
MONGODB_DB_NAME=love_laundry_users
MONGODB_COLLECTION=users

# ─── Security ────────────────────────────────────────────────────────────────
# JWT secret — keep this long, random, and secret in production
JWT_SECRET=super-secret-jwt-key-love-laundry-2026

# Master encryption key — used to derive the Key Encryption Key (KEK)
# Must be the SAME value across ALL services that share encrypted data!
MASTER_KEY=default-secret-master-key-love-laundry-2026
